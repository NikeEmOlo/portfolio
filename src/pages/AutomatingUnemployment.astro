---
import Base from '../layouts/Base.astro'
import HeroTextAnimation from '../components/HeroTextAnimation.astro'
---

<Base>
    <main class="main-wrapper">
        <section class="hero">
            <HeroTextAnimation lines={[
                { static: "designing", words: ["style guides", "design systems", "components"] },
                { static: "for",       words: ["humans", "teams", "clarity"] },
                { static: "with",      words: ["intention", "care", "code"] },
            ]} />
        </section>
    </main>
</Base>

<style>
    .main-wrapper {
        width: 100vw;
        padding: 5%;
    }

    section.hero {
        display: flex;
        flex-direction: column;
        width: 100%;
    }
</style>