---
import Base from '../layouts/Base.astro'
import ScrollPrompt from "../components/ScrollPrompt.astro"
import SectionLabel from "../components/text/SectionLabel.astro"
---

<Base>
    <section class="hero">
        <ScrollPrompt />
        <SectionLabel class="accent">A Case Study</SectionLabel>
        <h1 class="title biggest">Automating <span class="base-gradient">Unemployment</span><span class="accent">.</span></h1>
        <p class="standfirst">At my peak, I was spending <strong>12 hours per day</strong> searching for a job. Here's how I got three agents to do it for me.</p>
    </section>
    <section class="problem">
        <SectionLabel class="accent">The Problem</SectionLabel>
        <h2 class="title" id="problem-title">Do you know how time consuming it is being unemployed?</h2>
        <div class="stat">
            <p class="stat-metric"><span class="base-gradient">1.5 to 3</span><span class="stat-units">hrs</span></p>
            <p class="stat-caption">Just to research, tailor, and submit a <span class="orange">single</span> application</p>
        </div>
        <div class="list-wrap" id="exclusions">
            <SectionLabel class="label" id="this-excludes">This excludes</SectionLabel>
            <ul class="horizontal-list">
                <li>Take home tasks</li>
                <li>Cognitive and numeric assessments</li>
                <li>Two or more interviews</li>
                <li>Travel to interviews</li>
                <li>Communications</li>
            </ul>
        </div>
        <div class="stat" id="job-app-stats">
            <div class="metric-track">
                <p class="stat-metric">646</p>
                <p class="stat-metric">500</p>
                <p class="stat-metric">200</p>
                <p class="stat-metric">250</p>
            </div>
            <p class="stat-caption">these are the number of jobs some graduates have reportedly applied for without landing a role in 2026, as reported by the BBC</p>
        </div>
    </section>
</Base>

<style>
    body {
        --cream: #f2efe8;
        --orange: #e8722c;
        --muted-text: rgba(8, 14, 28, 0.4);
        --dark-background: #000000;
        /* This is a background attribute */
        --base-gradient-vert: linear-gradient(100deg, rgb(155, 111, 196), rgb(53, 158, 157)) text;
        
        background-color: var(--cream);
    }

    section {
        display: flex;
        width: 100%;
        flex-direction: column;
        align-items: center;


        &.hero {
            justify-content: center;
            position: relative;
            gap: 2.5em;
            
            min-height: 90dvh;
            background-color: #f2efe8;
            padding: 80px 24px 150px 24px;

        }

        &.problem {
            background-color: var(--dark-background);
            border-radius: 100vh 100vh 0 0;
            min-height: 100vh;
            padding-top: 10vh;
            gap: 5em;

        }
    }

        
    h3.section-title {
        font-family: var(--secondary-font);
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    h1.title {
        font-family: var(--secondary-font), system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        font-size: 6rem;
        font-weight: bold;
        line-height: 0.9;
        letter-spacing: -0.045em;
        text-align: center;
        text-transform: lowercase;

        &.biggest {
            display: inline;
            font-weight: 1000;
            font-size: clamp(54px, 13vw, 190px);
            margin-bottom: 2rem;
        }
    }

    h2.title {
        font-family: var(--secondary-font);
        font-size: clamp(30px, 5.2vw, 62px);
        font-weight: bold;
        color: white;
        text-align: center;
        width: max(50%, 300px);
        letter-spacing: -0.03em;
        line-height: 0.9;

        &#problem-title {
            margin-bottom: 15vh;
        }
    }


    p {
        font-family: var(--secondary-font);
        text-align: center;

        &.standfirst {
            margin-top: .5rem;
            width: 50vw;
            font-weight: 500;
            color: var(--muted-text);
        }
    }

    span {
        padding: 0;
        margin: 0;
    }

    div.stat {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 3rem;
        width: max-content;
        max-width: 90%;

        .stat-metric {
            font-size: clamp(58px, 11vw, 128px);
            font-weight: 400;
            letter-spacing: -0.05em;
            line-height: 0.8;
            padding: 0;
        }

        span.stat-units {
            font-size: 3rem;
            letter-spacing: -0.03em;
            color: rgb(153, 153, 153);
        }

        .stat-caption {
            text-transform: uppercase;
            text-align: left;
            font-size: 0.875rem;
            letter-spacing: 0.02;
            width: max(20%, 250px);
            color: rgb(153, 153, 153);
        }
    }

    /* The wide job-application stat row that drifts horizontally on scroll */
    div.stat#job-app-stats {
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 2rem;
        width: 100%;
        max-width: none;
        padding-left: clamp(16px, 5vw, 80px);
        overflow-x: clip;

        .metric-track {
            display: flex;
            align-items: flex-end;
            gap: clamp(2rem, 6vw, 8rem);
            width: max-content;
            will-change: transform;
        }

        .stat-metric {
            font-size: clamp(120px, 26vw, 340px);
            font-weight: 700;
            line-height: 0.8;
            letter-spacing: -0.04em;
            color: transparent;
            -webkit-text-stroke: 1px rgba(242, 239, 232, 0.5);
        }

        .stat-caption {
            text-transform: none;
            font-size: clamp(1rem, 1.4vw, 1.25rem);
            letter-spacing: 0;
            line-height: 1.3;
            width: max(30%, 320px);
        }
    }

    .list-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5vh;
        max-width: 80%;

        .horizontal-list {
            display: flex;
            gap: clamp(1.5rem, 4vw, 4rem);
            justify-content: center;
            padding: 0;
            flex-wrap: wrap;
        }

        li {
            list-style: none;
            font-family: var(--secondary-font);
            font-size: clamp(18px, 2vw, 28px);
            font-weight: 500;
            color: var(--cream);
            text-align: center;
            white-space: nowrap;
        }

        li::before {
            content: url(../assets/icons/star_splash.svg);
            margin-right: 0.8em;
            vertical-align: middle;
        }
    }

    @keyframes scroll-cue {
        0% {
            transform: translateY(0);
            opacity: .9;
        }

        100% {
            transform: translateY(12px);
            opacity: .12;
        }
    }
</style>

<script>
    // @ts-nocheck

    /* ===== Scroll-linked horizontal drift for the job application stats ===== */
    const jobAppStats = document.querySelector('#job-app-stats')
    const metricTrack = jobAppStats?.querySelector('.metric-track')

    function updateMetricDrift() {
        const rect = jobAppStats.getBoundingClientRect()
        const viewportHeight = window.innerHeight
        const maxDrift = window.innerWidth * 0.12 // how far the row travels, in px

        // 0 as the block enters from the bottom, 1 once it has scrolled past the top
        const rawProgress = (viewportHeight - rect.top) / (viewportHeight + rect.height)
        const progress = Math.min(Math.max(rawProgress, 0), 1)

        // Scroll down -> progress rises -> row slides left. Scroll up reverses it back right.
        const shift = -progress * maxDrift
        metricTrack.style.transform = `translate3d(${shift}px, 0, 0)`
    }

    let driftQueued = false
    function queueMetricDrift() {
        if (driftQueued) return
        driftQueued = true
        requestAnimationFrame(() => {
            updateMetricDrift()
            driftQueued = false
        })
    }

    if (metricTrack) {
        updateMetricDrift()
        window.addEventListener('scroll', queueMetricDrift, { passive: true })
        window.addEventListener('resize', queueMetricDrift)
    }
</script>
