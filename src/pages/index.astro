---
import '../styles/global.css'
import Base from '../layouts/Base.astro'
import { projects } from '../data/projects'
import Navigation from '../components/Navigation.astro'
import TarotCard from '../components/tarotCard/TarotCard.astro'
---
  <Base>
    <body>
      <main>
        <Navigation />
        <section aria-labelledby="projects-heading">
          <h2 id="projects-heading" class="visually-hidden">Projects</h2>
          <ul
            class="cards-row"
            role="list"
            data-active-category="dev"
            style={`--card-count: ${projects.length}`}>
            {projects.map((project, index) => (
              <li
                data-category={project.tab}
                style={`--index: ${index}`}
              >
                <TarotCard
                  numeral={project.numeral}
                  icon={project.icon}
                  label={project.projTitle}
                  tab={project.tab}
                />
              </li>
            ))}
          </ul>
        </section>
      </main>
      <div class="character-wrapper">
        <video id="character-intro" autoplay muted playsinline preload="auto">
          <source src="/intro_dark.webm" type="video/webm">
        </video>
        <video id="character-idle" muted playsinline loop preload="auto">
          <source src="/idle_dark.webm" type="video/webm">
        </video>
      </div>
    </body>
    <script>
      //------------------------VIDEO----------------------------------------//
        const intro = document.querySelector('#character-intro');
        const idle = document.querySelector('#character-idle');
        const wrapper = document.querySelector('.character-wrapper');

        if (intro && idle && wrapper) {
          // Decode and hold idle's first frame so it's ready to show instantly.
          idle.play().then(() => idle.pause());

          let swapped = false;

          function doSwap() {
            if (swapped) return;
            swapped = true;
            idle.currentTime = 0;
            idle.play();
            // Fade idle in over ~3 frames so the browser composites smoothly.
            idle.style.transition = 'opacity 0.1s linear';
            idle.style.opacity = '1';
          }

          intro.addEventListener('ended', () => {
            intro.style.opacity = '0';
          }, { once: true });

          if (intro.requestVideoFrameCallback) {
            function onIntroFrame(now, metadata) {
              if (intro.duration && (intro.duration - metadata.mediaTime) <= 2 / 24) {
                doSwap();
                return;
              }
              intro.requestVideoFrameCallback(onIntroFrame);
            }
            intro.requestVideoFrameCallback(onIntroFrame);
          }

          intro.addEventListener('ended', doSwap, { once: true });
        }

        //------------------------ZOOM LOCK-----------------------------------//
        if (matchMedia('(pointer: fine)').matches) {
          const baseRatio = window.devicePixelRatio;

          function counterZoom() {
            const scale = baseRatio / window.devicePixelRatio;
            wrapper.style.transform = `scale(${scale})`;
          }

          function watchZoom() {
            const mq = matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`);
            mq.addEventListener('change', function handler() {
              mq.removeEventListener('change', handler);
              counterZoom();
              watchZoom();
            });
          }

          watchZoom();
        }
    </script>
    <style>
      body {
        display: flex;
        flex-direction: column;
        overflow-x: clip;
        padding: 0;
      }
      main {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        width: 100%;
        min-height: 100dvh;
        padding: 40px;
        padding-top: calc(25vh + 60px);
        gap: 25vh;
      }
      /*
       * --Pb: pivot distance below the card bottom = horizontal semi-axis.
       * --b:  vertical semi-axis; b < Pb flattens the arc.
       * tx-b/ty-b place the card BOTTOM CENTRE on the ellipse; tx/ty then
       * back-calculate the card CENTRE by subtracting the rotated half-height.
       */
      .cards-row {
        list-style: none;
        padding: 0;
        margin: 0 auto;
        position: relative;
        width: clamp(140px, 7.5vw, 260px);
        height: clamp(235px, 12.5vw, 435px);
        --step-angle: 22deg;
        --Pb: 700px;
        --b: 280px;
      }
      @media (max-width: 1024px) {
        .cards-row {
          --step-angle: 11deg;
          --Pb: 280px;
          --b: 100px;
        }
      }
      .cards-row li.hidden {
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
        transform: translate(0, 0) rotate(0deg);
      }
      .cards-row li.at-center {
        transform: translate(0, 0) rotate(0deg) !important;
        pointer-events: none;
      }
      .cards-row.is-animating li {
        transition: transform 1s ease;
      }
      @media (max-width: 480px) {
        .cards-row li.hidden {
          display: none;
        }
      }
      .cards-row li {
        position: absolute;
        top: 0;
        left: 0;
        --n: calc(var(--index) - (var(--card-count) - 1) / 2);
        --arc-angle: calc(var(--n) * var(--step-angle));
        --tx-b: calc(var(--Pb) * sin(var(--arc-angle)));
        --ty-b: calc(var(--b) * (1 - cos(var(--arc-angle))));
        --theta: atan2(var(--tx-b), calc(var(--Pb) - var(--ty-b)));
        --tx: calc(var(--tx-b) - 117.5px * sin(var(--theta)));
        --ty: calc(117.5px * (1 - cos(var(--theta))) + var(--ty-b));
        transform: translate(var(--tx), var(--ty)) rotate(var(--theta));
        transition: transform 0.3s ease, opacity 0.2s ease;
        z-index: var(--index);
      }
      .cards-row li:hover,
      .cards-row li:focus-within {
        z-index: 10;
      }
      @media (max-width: 1024px) {
        .cards-row li:hover {
          z-index: var(--index);
          transform: translate(var(--tx), calc(var(--ty) - 30px)) rotate(var(--theta));
        }
      }
      @media (max-width: 480px) {
        main {
          padding-top: 20dvh;
          padding-inline: 16px;
        }
        .cards-row {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          width: 100%;
          height: auto;
          gap: 1rem;
        }
        .cards-row li {
          position: static;
          transform: none;
          transition: none;
        }
        .cards-row li:hover,
        .cards-row li:focus-within {
          transform: none;
          z-index: auto;
        }
      }

      .character-wrapper {
        position: fixed;
        bottom: 0;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        pointer-events: none;
        z-index: -1;
        transform-origin: bottom center;

        video {
          position: absolute;
          bottom: 0;
          left: 50%;
          transform: translateX(-50%);
          width: 1400px;
          max-width: unset;
          height: auto;
          pointer-events: none;
        }
      }

      #character-idle {
        opacity: 0;
      }

      @media (max-width: 480px) {
        .character-wrapper video {
          width: 900px;
        }
      }
    </style>
  </Base>

