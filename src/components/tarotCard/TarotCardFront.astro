    import "./tarotCardFront.js"
    import { tarotCardScale } from "../tarotCard/tarotInteractions.js"
    // Single source of truth: drive all scale-dependent card-front geometry (see CSS) off this.
    const cardFront = document.querySelector(".tarot-front")
    cardFront.style.setProperty("--scale", String(tarotCardScale))
</script>


<div class="tarot-front">
    <slot />
</div>

<style>
