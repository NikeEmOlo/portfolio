---
import '../../styles/global.css'
import CrabSVG from './CrabSVG.astro'
import CardDecor from './TarotCardDecor.astro'

const { numeral, icon, label } = Astro.props;
const icons = Object.fromEntries([['crab', CrabSVG]])
const IconComponent = icons[icon]
---

<button class="card-main" type="button" aria-label={label}>
    <div class="card">
        <CardDecor />
        <h6 class="numeral">{numeral}</h6>
        <div class="icon">
            <IconComponent />
        </div>
    </div>
</button>

<style>
    .card-main {
        width: clamp(140px, 7.5vw, 260px);
        height: clamp(235px, 12.5vw, 435px);
        padding: 3px;
        background: var(--tarot-gradient);
        border-radius: 8px;
        transition: transform 0.2s ease;
        border: none;
        cursor: pointer;
    }

    @media (min-width: 768px) and (hover: hover) {
        .card-main:hover {
            transform: scale(1.04);
        }
    }

    .card-main:focus-visible {
        transform: scale(1.04);
        outline: 2px solid transparent;
        box-shadow: 0 0 0 3px #fff4, 0 0 0 5px #8b5cf6;
    }

    .card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
        min-width: 100%;
        min-height: 100%;
        border-radius: 8px;
        background-color: #080E1C;
        overflow: hidden;
    }

    .numeral {
        position: absolute;
        top: 6px;
        background: var(--tarot-gradient);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        font-size: 20px;
    }
    
    .icon {
        position: absolute;
        left: calc(50% - 40.5px);
        top: calc(50% - 16px);
        width: 81px;
        height: 58px;
    }

    @media (max-width: 480px) {
        .card-main {
            width: 90px;
            height: 150px;
        }

        .card {
            min-height: 0;
            height: 100%;
        }

        .numeral {
            font-size: 13px;
        }

        .icon {
            width: 58%;
            height: auto;
            aspect-ratio: 81 / 58;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
        }
    }
</style>

