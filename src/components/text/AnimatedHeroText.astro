---
const { lines = [], size, fontSize } = Astro.props
---

<script>
import "./animatedHeroText.js"
</script>

<div class:list={["hero-text", size]} style={fontSize ? `--hero-font-size: ${fontSize}` : undefined}>
    {lines.map((line) => (
        <p class="hero-line">
            <span class="static">{line.static}</span>
            <span class="bracket">(<span class="word" data-words={JSON.stringify(line.words)}>{line.words[0]}</span>)</span>
        </p>
    ))}
</div>

<style>
    .hero-text {
        display: flex;
        flex-direction: column;
        font-family: var(--secondary-font);
        font-weight: 700;
        font-size: var(--hero-font-size, clamp(2.5rem, 7vw, 7rem));
        line-height: 1.05;
        color: #181614;
    }

    .hero-text.small {
        --hero-font-size: clamp(1.5rem, 3vw, 2.5rem);
    }

    .hero-text.medium {
        --hero-font-size: clamp(2.5rem, 5vw, 4.5rem);
    }

    .hero-text.large {
        --hero-font-size: clamp(3.5rem, 8vw, 8rem);
    }

    .hero-line {
        margin: 0;
        display: flex;
        align-items: baseline;
        gap: 0.25em;
        white-space: nowrap;
    }

    .bracket {
        display: inline-block;
        white-space: nowrap;
    }

    .word {
        display: inline-block;
        white-space: nowrap;
    }

    .hero-text :global(.letter) {
        display: inline-block;
        white-space: pre;
        overflow: clip;
        filter: blur(0px);
        will-change: width, filter, opacity;
    }
</style>
