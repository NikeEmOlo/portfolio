---
import { Image } from 'astro:assets'
const { images = [] } = Astro.props
---

<div class="carousel">
    <div class="group">
        {images.map((image) => (
            <Image src={image.src} alt={image.alt} class="image" />
        ))}
    </div>
    <div class="group" aria-hidden="true">
        {images.map((image) => (
            <Image src={image.src} alt={image.alt} class="image" />
        ))}
    </div>
</div>

<style>
    .carousel {
        --image-gap: clamp(1.5rem, 3vw, 3rem);

        display: flex;
        align-items: center;
        box-sizing: border-box;
        background: #1b1917;
        min-width: 100%;
        padding: var(--image-gap);

        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .carousel::-webkit-scrollbar {
        display: none;
    }

    .group {
        display: flex;
        align-items: center;
        gap: var(--image-gap);
        padding-right: var(--image-gap);
        animation: spin 30s infinite linear;
    }

    .image {
        flex: none;
        width: clamp(300px, 40vw, 700px);
        height: auto;
    }

    @keyframes spin {
        from {translate: 0;}
        to {translate: -100%;}
    }
    
</style>