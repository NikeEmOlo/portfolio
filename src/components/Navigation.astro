---
import '../styles/global.css'
import { getCollection } from 'astro:content'

// Each project's `category` is a { name: navSortOrder } map; collect the unique
// categories and order the tabs by that sort value (lowest first).
const projectEntries = await getCollection('projects')
const categorySortOrder = new Map()
for (const entry of projectEntries) {
    const [[name, sortOrder]] = Object.entries(entry.data.category)
    categorySortOrder.set(name, sortOrder)
}
const tabs = [...categorySortOrder.keys()].sort((a, b) => categorySortOrder.get(a) - categorySortOrder.get(b))
---

<nav>
    <button class="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
        <span></span>
        <span></span>
        <span></span>
    </button>
    <div class="nav-menu" id="nav-menu">
        <ul id="project-list">
            {tabs.map((tab) => {
                return <li><button data-category={tab}>{tab}</button></li>
            })}
        </ul>
        <div class="nav-separator" role="separator" aria-hidden="true"></div>
        <ul id="pages-list">
            <li><button>About</button></li>
            <li><button>Download CV</button></li>
            <li><button>Contact</button></li>
        </ul>
    </div>
        <button class="close-btn">Close</button>
</nav>
<div id="tab-announcement" aria-live="polite" aria-atomic="true" class="visually-hidden"></div>


<script>
    import "./navigation.js"
</script>

<style>
    nav {
        position: fixed;
        top: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        width: fit-content;
        min-height: 40px;
        border-radius: 16px;
        padding: 0 8px;
        z-index: 200;

        .close-btn {
            display: none;
        }
    }

    nav.tarot-close {
        & > *:not(.close-btn) {
            display: none;
        }

        & > .close-btn {
            display: flex;
            color: #ffffff4b;
        }

        /* Swap the border gradient to match the darkened portal world (navy → purple) */
        &::before {
            background: linear-gradient(0.3turn, #1a27566e 0%, #16245e75 100%);
        }
    }

    nav::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 2px;
        background: var(--tarot-gradient);
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask-composite: exclude;
        pointer-events: none;
    }

    .nav-menu {
        display: flex;
        align-items: center;
    }

    .nav-separator {
        width: 1px;
        height: 1.25rem;
        background: white;
        opacity: 0.35;
        margin: 0 0.5rem;
        flex-shrink: 0;
    }

    ul {
        display: flex;
        gap: 0.25rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    #pages-list button {
        color: var(--muted-text)
    }

    button {
        display: flex;
        align-items: center;
        background: none;
        padding: 6px 8px;
        border: none;
        border-radius: 8px;
        color: var(--text);
        font-family: var(--secondary-font);
        text-transform: capitalize;
        font-size: .85rem;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
    }

    button[aria-pressed="true"] {
        background: var(--text);
        color: black;
    }

    /* ── Hamburger button ── */
    .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 36px;
        height: 36px;
        padding: 7px;
        border-radius: 8px;
    }

    .hamburger span {
        display: block;
        width: 20px;
        height: 2px;
        border-radius: 2px;
        background: var(--tarot-gradient);
        transition: transform 0.25s ease, opacity 0.25s ease;
        transform-origin: center;
    }

    /* Animate into × when open */
    .hamburger[aria-expanded="true"] span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .hamburger[aria-expanded="true"] span:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    .hamburger[aria-expanded="true"] span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* ── Collapsed (hamburger) layout ── */
    nav.is-mobile {
        left: auto;
        right: 1.25rem;
        transform: none;
        padding: 0 4px;
        border-radius: 12px;
    }

    nav.is-mobile .hamburger {
        display: flex;
    }

    nav.is-mobile .nav-menu {
        display: none;
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        flex-direction: column;
        align-items: stretch;
        padding: 8px;
        border-radius: 12px;
        background-color: var(--ink);
        z-index: 100;
    }

    /* Gradient border on the dropdown */
    nav.is-mobile .nav-menu::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 12px;
        padding: 2px;
        background: var(--tarot-gradient);
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask-composite: exclude;
        pointer-events: none;
    }

    nav.is-mobile:has(.hamburger[aria-expanded="true"]) .nav-menu {
        display: flex;
    }

    nav.is-mobile ul {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    nav.is-mobile .nav-separator {
        width: 100%;
        height: 1px;
        margin: 4px 0;
        opacity: 0.25;
    }

    nav.is-mobile button {
        width: 100%;
        justify-content: center;
        padding: 10px ;
        font-size: 1rem;
    }
</style>
