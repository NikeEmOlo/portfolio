---
import '../styles/global.css'
import { projects } from '../data/projects'

const tabs = [...new Set(projects.map((project) => project.tab))]
const defaultTab = "Development"
---

<nav>
    <ul>
        {tabs.map((tab) => {
            return <li><button>{tab}</button></li>
        })}
        <li><button>About</button></li>
        <li><button>Download CV</button></li>
        <li><button>Contact</button></li>
    </ul>
</nav>

<script>
    document.querySelector("button")?.setAttribute("aria-pressed", "true")
    const tabButtons = document.querySelectorAll("button")
    tabButtons.forEach((button) => {
        button.addEventListener("click", () => {
            tabButtons.forEach((b) => {
                b.setAttribute('aria-pressed', b === button ? "true" : "false");
            })
        })
    })
</script>

<style>
    nav {
        position: relative;
        display: flex;
        align-items: center;
        width: fit-content;
        min-height: 40px;
        border-radius: 16px;
        padding: 0 8px;
    }

    /* Gradient border via mask: pseudo-element carries the gradient,
       mask punches out the inner area so only the border rim shows. */
    nav::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 2px;
        background: var(--tarot-gradient);
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask-composite: exclude;
        pointer-events: none;
    }

    ul {
        display: flex;
        gap: 0.25rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    button {
        display: flex;
        align-items: center;
        background: none;
        padding: 6px 8px;
        border: none;
        border-radius: 8px;
        color: white;

        font-family: var(--secondary-font);
        font-size: .85rem;
        line-height: 1;
        white-space: nowrap;
    }

    button[aria-pressed = "true"] {
        background: white;
        color: black;
    }
</style>