---
import '../styles/global.css'
import { projects } from '../data/projects'

const tabs = [...new Set(projects.map((project) => project.tab))]
---

<nav>
    <button class="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-list">
        <span></span>
        <span></span>
        <span></span>
    </button>
    <ul id="project-list">
        {tabs.map((tab) => {
            return <li><button data-category={tab}>{tab}</button></li>
        })}
    </ul>
    <p id="pipe">|</p>
    <ul id="pages-list">
        <li><button>About</button></li>
        <li><button>Download CV</button></li>
        <li><button>Contact</button></li>
    </ul>
</nav>

<script>
    // @ts-nocheck
    // init nav
    const navButtons = document.querySelectorAll('#project-list button')
    navButtons[0]?.setAttribute("aria-pressed", "true") //set first tab to active

    let isAnimating = false

    function applyFilter(category) {
        const allCards = [...document.querySelectorAll('.cards-row li[data-category]')]
        const visible = allCards.filter(c => c.dataset.category === category)
        allCards.forEach(c => c.classList.toggle('hidden', c.dataset.category !== category))
        document.querySelector('.cards-row')?.style.setProperty('--card-count', visible.length)
        visible.forEach((c, i) => c.style.setProperty('--index', i))
    }

    function animateTabSwitch(category) {
        const allCards = [...document.querySelectorAll('.cards-row li[data-category]')]
        const currentVisible = allCards.filter(c => !c.classList.contains('hidden'))
        const nextVisible = allCards.filter(c => c.dataset.category === category)
        const cardsRow = document.querySelector('.cards-row')

        isAnimating = true
        document.querySelectorAll('nav button').forEach(b => b.disabled = true)

        // Phase 1: fan current cards in to centre (1s) + 0.5s pause
        cardsRow.classList.add('is-animating')
        currentVisible.forEach(c => c.classList.add('at-center'))

        setTimeout(() => {
            // Update arc vars for the incoming set
            cardsRow.style.setProperty('--card-count', nextVisible.length)
            nextVisible.forEach((c, i) => c.style.setProperty('--index', i))

            // Swap: current goes hidden, next un-hides and fans out from centre
            allCards.forEach(c => {
                const isNext = c.dataset.category === category
                c.classList.toggle('hidden', !isNext)
                if (!isNext) c.classList.remove('at-center')
            })

            // Phase 2: fan-out completes after 1s, then clean up
            setTimeout(() => {
                cardsRow.classList.remove('is-animating')
                isAnimating = false
                navButtons.forEach(b => {
                    b.disabled = b.getAttribute('aria-pressed') === 'true'
                })
            }, 1000)
        }, 1500)
    }

    // Initial filter without animation
    const firstCategoryBtn = [...navButtons].find(b => b.dataset.category)
    if (firstCategoryBtn) {
        const allCards = [...document.querySelectorAll('.cards-row li[data-category]')]
        allCards.forEach(c => { c.style.transition = 'none' })
        applyFilter(firstCategoryBtn.dataset.category)
        requestAnimationFrame(() => allCards.forEach(c => { c.style.transition = '' }))
    }

    //Add an event listener to each button
    navButtons.forEach((button) => {
        button.addEventListener("click", () => {
            if (isAnimating) return
            navButtons.forEach((b) => {
                const isActive = b === button
                b.setAttribute('aria-pressed', isActive ? "true" : "false")
                b.disabled = isActive
            })
            if (button.dataset.category) animateTabSwitch(button.dataset.category)
        })
    })

//------------------------HAMBURGER MENU------------------------------//
    const hamburger = document.querySelector(".hamburger")

    function closeMenu() {
        hamburger?.setAttribute("aria-expanded", "false")
        hamburger?.setAttribute("aria-label", "Open menu")
    }

    if (hamburger) {
        hamburger.addEventListener("click", () => {
            const expanded = hamburger.getAttribute("aria-expanded") === "true"
            hamburger.setAttribute("aria-expanded", String(!expanded))
            hamburger.setAttribute("aria-label", expanded ? "Open menu" : "Close menu")
        })
    }

    navButtons.forEach((button) => {
        button.addEventListener("click", closeMenu)
    })

    document.addEventListener("click", (e) => {
        if (e.target instanceof Element && !e.target.closest("nav")) closeMenu()
    })

    // Switch to hamburger only when the nav would fill the viewport width
    const nav = document.querySelector("nav")

    function updateNavMode() {
        if (!nav) return
        const wasMobile = nav.classList.contains("is-mobile")
        nav.classList.remove("is-mobile")
        nav.style.width = "max-content"
        const naturalWidth = nav.offsetWidth
        nav.style.width = ""

        if (naturalWidth >= window.innerWidth) {
            nav.classList.add("is-mobile")
        } else if (wasMobile) {
            closeMenu()
        }
    }

    new ResizeObserver(updateNavMode).observe(document.documentElement)
    updateNavMode()
</script>

<style>
    nav {
        position: fixed;
        top: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        width: fit-content;
        min-height: 40px;
        border-radius: 16px;
        padding: 0 8px;
        z-index: 200;
    }

    nav::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 2px;
        background: var(--tarot-gradient);
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask-composite: exclude;
        pointer-events: none;
    }

    #pipe {
        color: white;
        font-size: 1.25rem;
        line-height: .8px;
        margin: 0 1rem;
    }

    ul {
        display: flex;
        gap: 0.25rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    #pages-list button {
        color: var(--muted-text)
    }

    button {
        display: flex;
        align-items: center;
        background: none;
        padding: 6px 8px;
        border: none;
        border-radius: 8px;
        color: #CFCFDF;
        font-family: var(--secondary-font);
        text-transform: capitalize;
        font-size: .85rem;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
    }

    button[aria-pressed="true"] {
        background: #CFCFDF;
        color: black;
    }

    /* ── Hamburger button ── */
    .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 36px;
        height: 36px;
        padding: 7px;
        border-radius: 8px;
    }

    .hamburger span {
        display: block;
        width: 20px;
        height: 2px;
        border-radius: 2px;
        background: var(--tarot-gradient);
        transition: transform 0.25s ease, opacity 0.25s ease;
        transform-origin: center;
    }

    /* Animate into × when open */
    .hamburger[aria-expanded="true"] span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .hamburger[aria-expanded="true"] span:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    .hamburger[aria-expanded="true"] span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* ── Collapsed (hamburger) layout ── */
    nav.is-mobile {
        left: auto;
        right: 1.25rem;
        transform: none;
        padding: 0 4px;
        border-radius: 12px;
    }

    nav.is-mobile .hamburger {
        display: flex;
    }

    nav.is-mobile ul {
        display: none;
        position: absolute;
        top: calc(100% + 10px);
        left: 50%;
        transform: translateX(-50%);
        flex-direction: column;
        gap: 2px;
        padding: 8px;
        border-radius: 12px;
        background-color: #080E1C;
        z-index: 100;
    }

    /* Gradient border on the dropdown */
    nav.is-mobile ul::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 12px;
        padding: 2px;
        background: var(--tarot-gradient);
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask-composite: exclude;
        pointer-events: none;
    }

    nav.is-mobile:has(.hamburger[aria-expanded="true"]) ul {
        display: flex;
    }

    nav.is-mobile #nav-list button {
        width: 100%;
        justify-content: center;
        padding: 10px 24px;
        font-size: 1rem;
    }
</style>
