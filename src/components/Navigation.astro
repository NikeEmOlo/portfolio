---
import '../styles/global.css'
import { projects } from '../data/projects'

const tabs = [...new Set(projects.map((project) => project.tab))]
---

<nav>
    <ul>
        {tabs.map((tab) => {
            return <li><button>{tab}</button></li>
        })}
        <li><button>About</button></li>
        <li><button>Download CV</button></li>
        <li><button>Contact</button></li>
    </ul>
</nav>

<style>
    nav {
        position: relative;
        display: flex;
        align-items: center;
        width: min(480px, 100%);
        height: 3rem;
        border-radius: 20px;
        padding: 4px 16px;
        background: transparent;
    }

    /* Gradient border via mask: pseudo-element carries the gradient,
       mask punches out the inner area so only the border rim shows. */
    nav::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 1.5px;
        background: var(--tarot-gradient);
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask-composite: exclude;
        pointer-events: none;
    }

    ul {
        display: flex;
        justify-content: space-between;
        gap: 0.25rem;
        list-style: none;
        width: 100%;
        padding: 0;
    }

    button {
        background: none;
        padding: 0;
        margin: 0;
        border: none;
        color: white;

        font-family: var(--david);
    }
</style>