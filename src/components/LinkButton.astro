---
const { destination, buttonTxt, variant } = Astro.props

---

<script>
import "./linkButton.js"
</script>

<a href={destination} class:list={["link-button", variant]} data-variant={variant}>
    <div>
        <p>{buttonTxt}</p>
    </div>
</a>

<style>
    a {
        display: flex;
        padding: 0;

        div {
            display: flex;
            justify-content: center;
            align-items: center;
            min-width: fit-content;
            min-height: fit-content;
            padding: 14px 20px;
            border-radius: 20px;
            background-color: var(--ink);
        }

        p {
            line-height: 0.8;
            font-family: var(--main-font);
            font-style: italic;
            font-weight: normal;
            font-size: 1rem;
            color: white;
        }
    }

    a.overview {
        div {
            background-color: transparent;
            border: none;
        }

        p {
            display: flex;
            font-size: 1.25rem;
            gap: 8px;
        }

        p::before {
            content: "";                 /* empty — just creates the box */      /* so it can take width/height */
            transform: translateY(2px);
            width: 1rem;
            height: 1rem;
            background-image: url("../assets/icons/four_sided_star_icon.svg");
            background-size: contain;    /* scale the SVG to fit the box */
            background-repeat: no-repeat;
            background-position: center;
        }


        p::after {
            content: "";                 /* empty — just creates the box */
            display: inline-block;       /* so it can take width/height */
            transform: translateY(-4px);
            width: .8rem;
            height: .8rem;
            background-image: url("../assets/icons/four_sided_star_icon.svg");
            background-size: contain;    /* scale the SVG to fit the box */
            background-repeat: no-repeat;
            background-position: center;
        }
    }
</style>